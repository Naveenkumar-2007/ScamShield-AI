# ScamShield AI - Environment Configuration

# Flask Application
SECRET_KEY=scamshield-super-secret-key-change-in-production-2026
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (MySQL 8)
# MySQL is optional. SQLite is used locally unless USE_MYSQL=True.
DB_USER=scamshield_user
DB_PASSWORD=scamshield_pass
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scamshield_db
# Direct URI override (optional):
# DATABASE_URL=mysql+pymysql://scamshield_user:scamshield_pass@127.0.0.1:3306/scamshield_db
# USE_MYSQL=False

# File Upload Security
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
UPLOAD_FOLDER=uploads

# Tesseract OCR Executable Path (Windows; optional on Linux/Render where it is on PATH)
# Set this if your local tesseract.exe is not in the standard Windows install location or PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional companion safety engine. The app uses its local safety checks when unset.
# SAFETY_ENGINE_URL=http://127.0.0.1:8081
